{
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "ask": [
      "Edit(./Config/**)"
    ],
    "deny": [
      "Edit(./Content/**)",
      "Edit(./Binaries/**)",
      "Edit(./Intermediate/**)",
      "Edit(./DerivedDataCache/**)",
      "Edit(./Saved/**)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git reset --hard *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/checkpoint.sh\""
          }
        ]
      }
    ]
  }
}
