{
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(bash Scripts/build.sh)",
      "Bash(bash Scripts/test.sh)",
      "Bash(bash Scripts/smoke.sh)",
      "Bash(git branch --show-current)",
      "Bash(git fetch)",
      "Bash(git pull --ff-only)",
      "Bash(git switch main)",
      "Bash(git switch -c task/*)",
      "Bash(git switch task/*)",
      "Bash(git merge --ff-only task/*)",
      "Bash(git merge --no-ff --no-edit task/*)",
      "Bash(git branch -d task/*)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git push origin --delete task/*)"
    ],
    "ask": [
      "Edit(./Config/**)"
    ],
    "deny": [
      "Edit(./Content/**)",
      "Edit(./Binaries/**)",
      "Edit(./Intermediate/**)",
      "Edit(./DerivedDataCache/**)",
      "Edit(./Saved/**)",
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push -uf*)",
      "Bash(git push * -uf*)",
      "Bash(git push -vf*)",
      "Bash(git push * -vf*)",
      "Bash(git push *+*)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--delete* main*)",
      "Bash(git push -d * main*)",
      "Bash(git push * -d * main*)",
      "Bash(git push *:main*)",
      "Bash(git push *:refs/heads/main*)",
      "Bash(git push *--delete* refs/heads/main*)",
      "Bash(git push -d * refs/heads/main*)",
      "Bash(git push * -d * refs/heads/main*)",
      "Bash(git push *--prune*)",
      "Bash(git reset --hard *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/checkpoint.sh\""
          }
        ]
      }
    ]
  }
}
