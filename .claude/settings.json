{
  "permissions": {
    "allow": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(bash Scripts/build.sh)",
      "Bash(bash Scripts/test.sh)",
      "Bash(bash Scripts/smoke.sh)"
    ],
    "ask": [
      "Edit(./Config/**)"
    ],
    "deny": [
      "Edit(./Content/**)",
      "Edit(./Binaries/**)",
      "Edit(./Intermediate/**)",
      "Edit(./DerivedDataCache/**)",
      "Edit(./Saved/**)",
      "Bash(git push *--force*)",
      "Bash(git push *-f*)",
      "Bash(git push *+*)",
      "Bash(git push *--delete*)",
      "Bash(git push *--mirror*)",
      "Bash(git reset --hard *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/checkpoint.sh\""
          }
        ]
      }
    ]
  }
}
